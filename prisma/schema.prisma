// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  createdAt     DateTime @default(now())

  votes     Vote[]
  userVotes UserVote[]

  @@map("users")
}

model Participant {
  id        String   @id @default(uuid())
  imageUrl  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  votes     VoteParticipant[]
  userVotes UserVote[]

  @@map("participants")
}

enum VoteStatus {
  ACTIVE
  CLOSED
}

model Vote {
  id        String     @id @default(uuid())
  createdAt DateTime   @default(now())
  title     String
  status    VoteStatus @default(ACTIVE)

  // esse voto pode ter um vencedor
  winner     VoteParticipant? @relation("VoteWinner", fields: [winnerId], references: [id])
  winnerId   String?          @unique
  winnerName String?          @unique

  user   User   @relation(fields: [userId], references: [id])
  userId String

  // many to many
  // nao precisa de fields e references porque a chave estrangeira vai ser criada em uma tabela intermediaria que o prisma cria
  participants VoteParticipant[] @relation("VoteParticipants")
  tied         VoteParticipant[] @relation("VoteTied")
  userVotes    UserVote[]

  @@map("votes")
}

model VoteParticipant {
  id String @id @default(uuid())

  vote   Vote   @relation("VoteParticipants", fields: [voteId], references: [id], onDelete: Cascade)
  voteId String

  // este VoteParticipant pode ser o vencedor de uma Vote
  winnerOf Vote? @relation("VoteWinner")

  // este VoteParticipant pode estar empatado em uma Vote
  tiedIn Vote[] @relation("VoteTied")

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  @@unique([voteId, participantId])
  @@map("vote_participants")
}

model UserVote {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  vote   Vote   @relation(fields: [voteId], references: [id], onDelete: Cascade)
  voteId String

  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  participantId String

  // campo para identificar votantes anônimos
  anonymousId String?

  // Agora verifica no código se userId OU anonymousId já votou
  @@index([voteId, participantId])
  @@index([voteId, anonymousId])
  @@index([voteId, userId])
  @@map("user_votes")
}
